
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",         // "auto" mendeteksi protokol gambar terbaik terminal Anda
        "source": "~/.config/fastfetch/framework_white.png", // Path gambar Anda
        "width": 28,            // Lebar gambar (dalam karakter terminal)
        "height": 14,           // Tinggi gambar
        "padding": {
            "top": 1,
            "left": 2,          // Memberi jarak ekstra di sebelah kiri gambar
            "right": 4          // Jarak pemisah antara gambar dan teks spek
        }
    },
    "display": {
        "key": {
            "width": 12         // Menjaga teks informasi tetap rapi di sebelah gambar
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory"
    ]
}

